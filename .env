PORT=5000
FRONTEND_URL=http://localhost:5173
DB_HOST=localhost
DB_PORT=3306
DB_NAME=campuswear
DB_USER=root
DB_PASSWORD=Mysql123
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Production image storage (optional but recommended)
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BACKUP_INTERVAL_HOURS=24

# Admin seed password (required in production)
ADMIN_EMAIL=admin@campuswear.com
ADMIN_PASSWORD=AdminCampus1234


# Student coupon verification (recommended for real use)
RESEND_API_KEY=
EMAIL_FROM=CampusWear <offers@your-verified-domain.com>
# Local testing only: when true and email is not configured, the OTP is returned by the API and shown in the UI. Keep false in production.
ALLOW_DEV_OTP=true
# Production email notifications (Resend)
ALLOW_DEV_EMAIL=true
# RESEND_API_KEY=
# EMAIL_FROM=CampusWear <orders@your-verified-domain.com>
# Production image storage: leave blank for local /uploads, or configure S3-compatible storage.

# Shiprocket shipping integration (optional until a merchant account is available)
# Keep credentials private. Configure pickup location exactly as registered in Shiprocket.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_PICKUP_POSTCODE=
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_CHANNEL=CampusWear
SHIPROCKET_FALLBACK_EMAIL=
# Approximate parcel defaults; update to match actual packed orders.
SHIPROCKET_PARCEL_LENGTH_CM=20
SHIPROCKET_PARCEL_BREADTH_CM=15
SHIPROCKET_PARCEL_HEIGHT_CM=5
SHIPROCKET_PARCEL_WEIGHT_KG=0.5
